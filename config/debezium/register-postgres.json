{
  "name": "postgres-ledger-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "plugin.name": "pgoutput",
    "database.hostname": "postgres_db",
    "database.port": "5432",
    "database.user": "ledger_admin",
    "database.password": "ledger_secret",
    "database.dbname": "ledger_db",
    "topic.prefix": "fintech",
    "table.include.list": "public.merchants,public.accounts,public.transactions",
    "slot.name": "fintech_cdc_slot",
    "publication.name": "fintech_cdc_publication",
    "publication.autocreate.mode": "filtered",
    "decimal.handling.mode": "double",
    "tombstones.on.delete": "false"
  }
}